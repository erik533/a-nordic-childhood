{
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "15 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/founding-families/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
